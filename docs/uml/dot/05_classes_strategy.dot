digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.32", nodesep=.52, ranksep=.87, splines=polyline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=12];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#5C7280", fontname="DejaVu Sans", fontsize=10, arrowsize=.85, penwidth=1.3];
  Iface [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;&lt;&lt;interface&gt;&gt;&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PrecoConsultaStrategy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ calcularPreco(pet): BigDecimal</FONT></TD></TR></TABLE>>];
  Service [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Service&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PrecoConsultaService</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- estrategiasPorTipo: Map&lt;String, PrecoConsultaStrategy&gt;<BR ALIGN="LEFT"/>- estrategiaPadrao: PrecoConsultaStrategy</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ estrategiaPara(pet): PrecoConsultaStrategy<BR ALIGN="LEFT"/>+ calcularPreco(pet): BigDecimal</FONT></TD></TR></TABLE>>];
  Dog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Component(&quot;dog&quot;)&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PrecoConsultaCao</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ calcularPreco(pet): BigDecimal</FONT></TD></TR></TABLE>>];
  Cat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Component(&quot;cat&quot;)&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PrecoConsultaGato</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ calcularPreco(pet): BigDecimal</FONT></TD></TR></TABLE>>];
  Default [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Component(&quot;padrao&quot;)&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PrecoConsultaPadrao</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ calcularPreco(pet): BigDecimal</FONT></TD></TR></TABLE>>];
  WebConfig [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FFF4E4" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#AF7932" POINT-SIZE="10">&lt;&lt;&lt;&lt;HandlerInterceptor&gt;&gt;&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PrecoConsultaWebConfiguration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ postHandle(...): void</FONT></TD></TR></TABLE>>];
  Pet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;@Entity / pets&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Pet</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- type: PetType<BR ALIGN="LEFT"/>- birthDate: LocalDate</FONT></TD></TR></TABLE>>];
 {rank=same;Dog;Cat;Default;}
  Dog -> Iface [arrowhead=empty, style=dashed, penwidth=1.8,color="#3A718E"];
  Cat -> Iface [arrowhead=empty, style=dashed, penwidth=1.8,color="#3A718E"];
  Default -> Iface [arrowhead=empty, style=dashed, penwidth=1.8,color="#3A718E"];
  Service -> Iface [color="#176749",label="guarda estratégias",style=dashed, penwidth=1.5];
  WebConfig -> Service [color="#176749",label="calcula / adiciona ao Model",style=dashed, penwidth=1.5];
  Iface -> Pet [color="#176749",label="parâmetro do cálculo",style=dashed, penwidth=1.5];
}
