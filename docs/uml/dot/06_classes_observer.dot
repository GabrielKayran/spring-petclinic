digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.32", nodesep=.48, ranksep=.75, splines=polyline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=12];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#5C7280", fontname="DejaVu Sans", fontsize=10, arrowsize=.85, penwidth=1.3];
  VC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Controller&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>VisitController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- owners: OwnerRepository<BR ALIGN="LEFT"/>- events: ApplicationEventPublisher</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ processNewVisitForm(...): String</FONT></TD></TR></TABLE>>];
  REPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;interface&gt;&gt; JpaRepository&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>OwnerRepository</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ save(owner): Owner</FONT></TD></TR></TABLE>>];
  PUB [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;Spring interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>ApplicationEventPublisher</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ publishEvent(event): void</FONT></TD></TR></TABLE>>];
  EVT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;extends ApplicationEvent&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>VisitRegisteredEvent</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- ownerName: String<BR ALIGN="LEFT"/>- petName: String<BR ALIGN="LEFT"/>- visitDate: LocalDate<BR ALIGN="LEFT"/>- description: String</FONT></TD></TR></TABLE>>];
  L [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Component&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>VisitReminderListener</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">@Async<BR ALIGN="LEFT"/>@EventListener</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ sendReminder(event): void</FONT></TD></TR></TABLE>>];
  CONF [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FFF4E4" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#AF7932" POINT-SIZE="10">&lt;&lt;@EnableAsync&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>AsyncConfiguration</B></FONT></TD></TR></TABLE>>];
  AppEvent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;Spring type&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>ApplicationEvent</B></FONT></TD></TR></TABLE>>];
  VC -> REPO [label="save(owner)",color="#176749",fontcolor="#176749",style=dashed,penwidth=1.7];
  VC -> PUB [label="publica evento",color="#176749",fontcolor="#176749",style=dashed,penwidth=1.7];
  PUB -> EVT [label="despacha tipo",color="#176749",fontcolor="#176749",style=dashed,penwidth=1.7];
  L -> EVT [label="observa",color="#176749",fontcolor="#176749",style=dashed,penwidth=1.7];
  CONF -> L [label="habilita async",color="#176749",fontcolor="#176749",style=dashed,penwidth=1.7];
  EVT -> AppEvent [arrowhead=empty,penwidth=1.6,color="#3A718E"];
}
