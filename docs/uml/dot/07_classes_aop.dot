digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.32", nodesep=.57, ranksep=.92, splines=polyline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=12];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#5C7280", fontname="DejaVu Sans", fontsize=10, arrowsize=.85, penwidth=1.3];
  Ann [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;&lt;&lt;annotation&gt;&gt;&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Auditado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ value(): String</FONT></TD></TR></TABLE>>];
  Asp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Aspect / @Component&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>AuditoriaAspect</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ auditar(joinPoint, auditado): Object</FONT></TD></TR></TABLE>>];
  OwnerC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Controller&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>OwnerController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ showOwner(ownerId): ModelAndView</FONT></TD></TR></TABLE>>];
  VetC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Controller&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>VetController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ showResourcesVetList(): Vets</FONT></TD></TR></TABLE>>];
  VisitC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Controller&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>VisitController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ processNewVisitForm(...): String</FONT></TD></TR></TABLE>>];
  Proxy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FFF4E4" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#AF7932" POINT-SIZE="10">&lt;&lt;&lt;&lt;gerado pelo Spring&gt;&gt;&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Proxy CGLIB</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">não existe como .java no ZIP</FONT></TD></TR></TABLE>>];
  {rank=same; OwnerC; VetC; VisitC;}
  Asp -> Ann [label="pointcut @annotation", style=dashed, color="#176749"];
  OwnerC -> Ann [label="@Auditado", color="#3A718E", style=dashed, constraint=false];
  Proxy -> OwnerC [label="intercepta", color="#AF7932",style=dashed];
  VetC -> Ann [label="@Auditado", color="#3A718E", style=dashed, constraint=false];
  Proxy -> VetC [label="intercepta", color="#AF7932",style=dashed];
  VisitC -> Ann [label="@Auditado", color="#3A718E", style=dashed, constraint=false];
  Proxy -> VisitC [label="intercepta", color="#AF7932",style=dashed];
  Proxy -> Asp [label="@Around / proceed()",color="#AF7932",style=dashed];
}
