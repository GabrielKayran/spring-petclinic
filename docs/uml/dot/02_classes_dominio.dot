digraph G {
  graph [rankdir=BT, bgcolor="transparent", pad="0.32", nodesep=.45, ranksep=.85, splines=polyline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=12];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#5C7280", fontname="DejaVu Sans", fontsize=10, arrowsize=.85, penwidth=1.3];
  edge [arrowhead=none];
  BaseEntity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;@MappedSuperclass&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>BaseEntity</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- id: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ getId(): Integer<BR ALIGN="LEFT"/>+ isNew(): boolean</FONT></TD></TR></TABLE>>];
  Person [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;@MappedSuperclass&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Person</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- firstName: String<BR ALIGN="LEFT"/>- lastName: String</FONT></TD></TR></TABLE>>];
  NamedEntity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;@MappedSuperclass&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>NamedEntity</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- name: String</FONT></TD></TR></TABLE>>];
  Owner [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Entity / owners&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Owner</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- address: String<BR ALIGN="LEFT"/>- city: String<BR ALIGN="LEFT"/>- telephone: String<BR ALIGN="LEFT"/>- pets: List&lt;Pet&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ addPet(pet): void<BR ALIGN="LEFT"/>+ addVisit(petId, visit): void</FONT></TD></TR></TABLE>>];
  Vet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Entity / vets&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Vet</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- specialties: Set&lt;Specialty&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ addSpecialty(...): void</FONT></TD></TR></TABLE>>];
  Pet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Entity / pets&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Pet</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- birthDate: LocalDate<BR ALIGN="LEFT"/>- type: PetType<BR ALIGN="LEFT"/>- visits: Set&lt;Visit&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">+ addVisit(visit): void</FONT></TD></TR></TABLE>>];
  PetType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Entity / types&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PetType</B></FONT></TD></TR></TABLE>>];
  Visit [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Entity / visits&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Visit</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">- date: LocalDate<BR ALIGN="LEFT"/>- description: String</FONT></TD></TR></TABLE>>];
  Specialty [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Entity / specialties&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Specialty</B></FONT></TD></TR></TABLE>>];
  {rank=same; Person; NamedEntity; Visit;}
  {rank=same; Owner; Vet; Pet; PetType; Specialty;}
  Person -> BaseEntity [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  NamedEntity -> BaseEntity [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  Visit -> BaseEntity [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  Owner -> Person [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  Vet -> Person [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  Pet -> NamedEntity [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  PetType -> NamedEntity [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  Specialty -> NamedEntity [arrowhead=empty, arrowsize=1.1, color="#3A718E", penwidth=1.6];
  Owner -> Pet [dir=forward, arrowhead=vee, color="#176749", fontcolor="#176749", label="pets", taillabel="1", headlabel="0..*", labeldistance=1.4, decorate=false, constraint=false, penwidth=1.9];
  Pet -> Visit [dir=forward, arrowhead=vee, color="#176749", fontcolor="#176749", label="visits", taillabel="1", headlabel="0..*", labeldistance=1.4, decorate=false, constraint=false, penwidth=1.9];
  Pet -> PetType [dir=forward, arrowhead=vee, color="#176749", fontcolor="#176749", label="type", taillabel="0..*", headlabel="1", labeldistance=1.4, decorate=false, constraint=false, penwidth=1.9];
  Vet -> Specialty [dir=forward, arrowhead=vee, color="#176749", fontcolor="#176749", label="specialties", taillabel="0..*", headlabel="0..*", labeldistance=1.4, decorate=false, constraint=false, penwidth=1.9];
}
