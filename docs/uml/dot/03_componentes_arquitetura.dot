digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.32", nodesep=.48, ranksep=.65, splines=polyline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=12];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#5C7280", fontname="DejaVu Sans", fontsize=10, arrowsize=.85, penwidth=1.3];
  Browser [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;interface web&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Navegador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">HTML / JavaScript<BR ALIGN="LEFT"/>petclinic-poo2.onrender.com</FONT></TD></TR></TABLE>>];
  Web [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;interface / controle&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Spring MVC + Thymeleaf</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">Tomcat HTTP 8080<BR ALIGN="LEFT"/>views + controllers</FONT></TD></TR></TABLE>>];
  Owners [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;Controller&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Controllers de domínio</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">Owner, Pet, Visit, Vet</FONT></TD></TR></TABLE>>];
  Strategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;Service&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Estratégias de preço</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">PrecoConsultaService<BR ALIGN="LEFT"/>dog / cat / padrao</FONT></TD></TR></TABLE>>];
  Events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Async&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Eventos e listener</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">ApplicationEventPublisher<BR ALIGN="LEFT"/>LembreteVisitaListener</FONT></TD></TR></TABLE>>];
  Aop [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;@Aspect&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Auditoria AOP</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">@Auditado / proxy CGLIB</FONT></TD></TR></TABLE>>];
  Repo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;persistência&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Spring Data JPA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">OwnerRepository<BR ALIGN="LEFT"/>VetRepository<BR ALIGN="LEFT"/>Hibernate</FONT></TD></TR></TABLE>>];
  H2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF3F8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#3A718E" POINT-SIZE="10">&lt;&lt;produção: profile postgres&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>PostgreSQL (Neon)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">testes: H2 em memória</FONT></TD></TR></TABLE>>];
  Panel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FFF4E4" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#AF7932" POINT-SIZE="10">&lt;&lt;CASE STUDY&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Painel acadêmico</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">PainelController<BR ALIGN="LEFT"/>demonstrações /painel</FONT></TD></TR></TABLE>>];
  gClient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FFF4E4" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#AF7932" POINT-SIZE="10">&lt;&lt;client&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Cliente gRPC do painel</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">GrpcDemoCliente</FONT></TD></TR></TABLE>>];
  gServer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FFF4E4" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#AF7932" POINT-SIZE="10">&lt;&lt;gRPC service&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Servidor gRPC</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">VeterinarioGrpcService<BR ALIGN="LEFT"/>Netty localhost:9090</FONT></TD></TR></TABLE>>];
  Report [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#BBD1CC" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F6EF" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="DejaVu Sans" COLOR="#176749" POINT-SIZE="10">&lt;&lt;Service&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#162C35" POINT-SIZE="15"><B>Relatórios PDF</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#203943">RelatorioService<BR ALIGN="LEFT"/>JasperReports 7</FONT></TD></TR></TABLE>>];
  {rank=same; Owners; Strategy; Events; Aop;}
  {rank=same; Repo; gServer;}
  Browser -> Web [color="#5C7280", label="HTTP", fontcolor="#5C7280", penwidth=1.7];
  Web -> Owners [color="#5C7280", label="MVC", fontcolor="#5C7280", penwidth=1.7];
  Owners -> Repo [color="#176749", label="save / find", fontcolor="#176749", penwidth=1.7];
  Repo -> H2 [color="#5C7280", label="JDBC", fontcolor="#5C7280", penwidth=1.7];
  Web -> Strategy [color="#176749", label="interceptor de preço", fontcolor="#176749", penwidth=1.7];
  Owners -> Events [color="#176749", label="publishEvent", fontcolor="#176749", penwidth=1.7];
  Aop -> Owners [color="#176749", label="intercepta", fontcolor="#176749", penwidth=1.7];
  Web -> Panel [color="#AF7932", label="/painel", fontcolor="#AF7932", penwidth=1.7];
  Panel -> gClient [color="#AF7932", label="chamada", fontcolor="#AF7932", penwidth=1.7];
  gClient -> gServer [color="#AF7932", label="gRPC :9090", fontcolor="#AF7932", penwidth=1.7];
  gServer -> Repo [color="#AF7932", label="findAll(vets)", fontcolor="#AF7932", penwidth=1.7];
  Report -> Repo [color="#5C7280", label="dados", fontcolor="#5C7280", penwidth=1.7];
  Report -> Strategy [color="#176749", style=dashed, label="preço via Strategy", fontcolor="#176749", penwidth=1.7];
}
