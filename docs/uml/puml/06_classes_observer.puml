@startuml
skinparam backgroundColor white
skinparam shadowing false
class VisitController <<@Controller>> {
 - owners: OwnerRepository
 - events: ApplicationEventPublisher
 + processNewVisitForm(...): String
}
interface OwnerRepository
interface ApplicationEventPublisher {
 + publishEvent(event): void
}
class ApplicationEvent
class VisitRegisteredEvent {
 - ownerName: String
 - petName: String
 - visitDate: LocalDate
 - description: String
}
class VisitReminderListener <<@Component>> {
 + sendReminder(event: VisitRegisteredEvent): void
}
class AsyncConfiguration <<@EnableAsync>>
ApplicationEvent <|-- VisitRegisteredEvent
VisitController --> OwnerRepository : save(owner)
VisitController --> ApplicationEventPublisher : publishEvent
VisitController ..> VisitRegisteredEvent : cria
VisitReminderListener ..> VisitRegisteredEvent : observa @EventListener
AsyncConfiguration ..> VisitReminderListener : @Async
note right of VisitReminderListener
  Thread.sleep(2 s) simula lembrete.
  Sem envio externo real.
end note
@enduml
