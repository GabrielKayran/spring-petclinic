@startuml
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false
interface PrecoConsultaStrategy {
 + calcularPreco(pet: Pet): BigDecimal
}
class PrecoConsultaCao <<@Component("dog")>> {
  + calcularPreco(pet): BigDecimal
}
class PrecoConsultaGato <<@Component("cat")>> {
  + calcularPreco(pet): BigDecimal
}
class PrecoConsultaPadrao <<@Component("padrao")>> {
  + calcularPreco(pet): BigDecimal
}
class PrecoConsultaService <<@Service>> {
 - estrategiasPorTipo: Map<String, PrecoConsultaStrategy>
 - estrategiaPadrao: PrecoConsultaStrategy
 + estrategiaPara(pet): PrecoConsultaStrategy
 + calcularPreco(pet): BigDecimal
}
class PrecoConsultaWebConfiguration <<HandlerInterceptor>> {
 + postHandle(...): void
}
class Pet <<Entity>>
PrecoConsultaStrategy <|.. PrecoConsultaCao
PrecoConsultaStrategy <|.. PrecoConsultaGato
PrecoConsultaStrategy <|.. PrecoConsultaPadrao
PrecoConsultaService o--> "*" PrecoConsultaStrategy : injeção pelo Spring
PrecoConsultaWebConfiguration ..> PrecoConsultaService : usa
PrecoConsultaStrategy ..> Pet : argumento
note right of PrecoConsultaService
  Map: dog / cat / padrao
  getOrDefault(tipo, estrategiaPadrao)
end note
note bottom of Pet
  Valor apenas exibido na tela;
  não salvo como preço da visita.
end note
@enduml
