@startuml
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false
interface VisitPriceStrategy {
 + calculatePrice(pet: Pet): BigDecimal
}
class DogPriceStrategy <<@Component("dog")>> {
  + calculatePrice(pet): BigDecimal
}
class CatPriceStrategy <<@Component("cat")>> {
  + calculatePrice(pet): BigDecimal
}
class DefaultPriceStrategy <<@Component("padrao")>> {
  + calculatePrice(pet): BigDecimal
}
class VisitPriceService <<@Service>> {
 - strategiesByType: Map<String, VisitPriceStrategy>
 - defaultStrategy: VisitPriceStrategy
 + strategyFor(pet): VisitPriceStrategy
 + calculatePrice(pet): BigDecimal
}
class VisitPriceWebConfiguration <<HandlerInterceptor>> {
 + postHandle(...): void
}
class Pet <<Entity>>
VisitPriceStrategy <|.. DogPriceStrategy
VisitPriceStrategy <|.. CatPriceStrategy
VisitPriceStrategy <|.. DefaultPriceStrategy
VisitPriceService o--> "*" VisitPriceStrategy : injeção pelo Spring
VisitPriceWebConfiguration ..> VisitPriceService : usa
VisitPriceStrategy ..> Pet : argumento
note right of VisitPriceService
  Map: dog / cat / padrao
  getOrDefault(tipo, defaultStrategy)
end note
note bottom of Pet
  Valor apenas exibido na tela;
  não salvo como preço da visita.
end note
@enduml
