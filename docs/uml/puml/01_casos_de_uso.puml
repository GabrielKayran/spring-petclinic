@startuml
skinparam backgroundColor white
skinparam shadowing false
left to right direction
actor "Usuário da interface\n(sem papéis/autenticação)" as U
rectangle "Spring PetClinic - interface web" {
  usecase "Localizar/listar tutores" as UC1
  usecase "Cadastrar tutor" as UC2
  usecase "Consultar dados do tutor" as UC3
  usecase "Cadastrar/editar pet" as UC4
  usecase "Registrar visita do pet" as UC5
  usecase "Consultar veterinários" as UC6
  usecase "Consultar histórico\nde visitas" as UC7
  usecase "Acessar painel de estudo" as UC8
}
U -- UC1
U -- UC2
U -- UC3
U -- UC4
U -- UC5
U -- UC6
U -- UC7
U -- UC8
note right of UC8
  Extensão acadêmica do fork.
end note
@enduml
